{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rad-agent.dev/schemas/financial-decision-request-1.0.json",
  "title": "Financial decision request",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {"enum": ["portfolio.allocate", "valuation.estimate", "market.assess"]}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "portfolio.allocate"}}},
      "then": {
        "required": ["expected_returns", "covariance"],
        "properties": {
          "operation": {"const": "portfolio.allocate"},
          "expected_returns": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "number", "minimum": -5, "maximum": 5}},
          "covariance": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "number", "minimum": -25, "maximum": 25}}},
          "previous_weights": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "risk_aversion": {"type": "number", "minimum": 0.01, "maximum": 100},
          "transaction_cost": {"type": "number", "minimum": 0, "maximum": 1},
          "cardinality_penalty": {"type": "number", "minimum": 0, "maximum": 1},
          "min_position": {"type": "number", "minimum": 0, "maximum": 1},
          "max_assets": {"type": "integer", "minimum": 1, "maximum": 64},
          "steps": {"type": "integer", "minimum": 100, "maximum": 100000},
          "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {"properties": {"operation": {"const": "valuation.estimate"}}},
      "then": {
        "required": ["cashflows", "discount_rate"],
        "properties": {
          "operation": {"const": "valuation.estimate"},
          "cashflows": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000000}},
          "discount_rate": {"type": "number", "exclusiveMinimum": 0.02, "maximum": 10},
          "growth_mu": {"type": "number", "minimum": -0.99, "maximum": 2},
          "growth_sigma": {"type": "number", "minimum": 0, "maximum": 2},
          "simulations": {"type": "integer", "minimum": 100, "maximum": 100000},
          "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {"properties": {"operation": {"const": "market.assess"}}},
      "then": {
        "required": ["prices"],
        "properties": {
          "operation": {"const": "market.assess"},
          "prices": {"type": "array", "minItems": 20, "maxItems": 100000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000000}},
          "window": {"type": "integer", "minimum": 20, "maximum": 5000},
          "horizon": {"type": "integer", "minimum": 1, "maximum": 252},
          "neutral_band": {"type": "number", "minimum": 0, "maximum": 0.49}
        },
        "additionalProperties": false
      }
    }
  ]
}
